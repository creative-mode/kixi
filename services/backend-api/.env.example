# Kixi backend-api — example environment
# Copy to .env and adjust: cp .env.example .env
# Spring Boot relaxed binding maps UPPER_CASE vars to dotted properties.

# === Profiles / server ===
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# === Database (R2DBC). Flyway derives its JDBC URL from SPRING_R2DBC_URL. ===
DB_NAME=banco_enunciados
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
SPRING_R2DBC_URL=r2dbc:postgresql://postgres:5432/banco_enunciados
SPRING_R2DBC_USERNAME=postgres
SPRING_R2DBC_PASSWORD=postgres
# Optional override when Flyway must use a different JDBC endpoint.
# SPRING_FLYWAY_URL=jdbc:postgresql://postgres:5432/banco_enunciados
# Legacy init.sql databases must baseline at V16, then apply V17 and V18.
# Fresh databases do not baseline because their schema is empty.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=16

# === JWT (required). Must be >= 32 chars. Prod refuses to start without it. ===
APP_JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters
APP_JWT_EXPIRATION_MS=86400000

# === CORS (comma-separated browser origins: landing, aluno, manager) ===
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# === OCR service ===
OCR_SERVICE_URL=http://ocr-service:8000
OCR_SERVICE_TIMEOUT_MS=120000
# Max retries and API key for backend-to-OCR auth (compose maps OCR_API_KEY here).
OCR_SERVICE_MAX_RETRIES=2
OCR_SERVICE_API_KEY=

# === Object storage (storage.*) ===
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/tmp/kixi/uploads
STORAGE_PUBLIC_BASE_URL=/uploads
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=kixi-images
STORAGE_S3_ACCESS_KEY=kixi-minio
STORAGE_S3_SECRET_KEY=kixi-minio-secret
STORAGE_S3_PATH_STYLE_ACCESS=true
STORAGE_MAX_OBJECT_SIZE_BYTES=20971520

# === Google OAuth (app.auth.google.*) — optional ===
APP_AUTH_GOOGLE_CLIENT_ID=
APP_AUTH_GOOGLE_CLIENT_SECRET=
APP_AUTH_GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
APP_AUTH_GOOGLE_STATE_COOKIE_SECURE=true

# === AI (reserved, no consumer in code yet) ===
# GROQ_API_KEY=

# === Registration rate limit (app.auth.registration-rate-limit.*) ===
APP_AUTH_REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=5
APP_AUTH_REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=900

# === Logging ===
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_AO_CREATIVEMODE=DEBUG
