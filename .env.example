# Kixi platform — root example environment for docker compose
# Copy to .env and adjust: cp .env.example .env
# Generate secrets with: openssl rand -hex 32

# === Required: set real values before Compose can start ===
APP_JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters
OCR_API_KEY=change-me-to-a-random-ocr-api-key

# === Database ===
POSTGRES_DB=kixi
POSTGRES_USER=kixi
# Set a unique database password before `docker compose up`.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# Backend R2DBC connection pool (see infra/load/RELATORIO.md).
R2DBC_POOL_INITIAL_SIZE=10
R2DBC_POOL_MAX_SIZE=40

# === Backend ===
BACKEND_PORT=8080
# Deployments must use `prod` so placeholder secrets are rejected at startup.
SPRING_PROFILE=docker
APP_JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Comma-separated IPs of direct proxy peers seen by the backend (not public client IPs).
# Production must list only the Caddy/manager/student containers that connect to this API.
# Leave empty for direct local development; production logs a warning when empty.
APP_TRUSTED_PROXY_IPS=
# Login rate limits: per identity and per client address, in attempts/window.
APP_AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
APP_AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_ADDRESS=60
APP_AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# Google OAuth callback and upload abuse limits (app.security.rate-limit.*).
APP_SECURITY_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
APP_SECURITY_RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# Profile, colleague and teacher searches share one budget per account (#406).
APP_SECURITY_RATE_LIMIT_SEARCH_MAX_ATTEMPTS=60
APP_SECURITY_RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
# Simulation deadline grace period and expiry sweep interval.
APP_SIMULATIONS_TOLERANCE_SECONDS=10
APP_SIMULATIONS_EXPIRY_POLL_MS=60000
# API docs (springdoc). Set both to false in production to hide the API map.
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
# First ADMIN bootstrap (optional): with all three set, startup creates the
# first administrator if none exists. Without them nothing is created.
# Never commit real values here. After the first boot, remove the password
# from the environment and change it in the manager.
# APP_BOOTSTRAP_ADMIN_USERNAME=admin
# APP_BOOTSTRAP_ADMIN_EMAIL=admin@kixi.ao
# APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password
# AI tutor (optional): without a key the /api/v1/chat endpoints answer 503.
# GROQ_API_KEY=

# === OCR service ===
ENVIRONMENT=docker
OCR_DEBUG=false
OCR_PORT=8000
OCR_WORKERS=1
OCR_LANG=pt
MAX_IMAGE_SIZE_MB=20.0
MAX_UPLOAD_SIZE_MB=50.0
MAX_IMAGES_PER_REQUEST=10
MAX_PDF_PAGES=50
MAX_OCR_PAGES_PER_REQUEST=50
OCR_USE_GPU=false
OCR_LOG_LEVEL=INFO
