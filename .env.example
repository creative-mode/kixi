# Kixi platform — root example environment for docker compose
# Copy to .env and adjust: cp .env.example .env
# Generate secrets with: openssl rand -hex 32

# === Required: compose fails fast without these ===
APP_JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters
OCR_API_KEY=change-me-to-a-random-ocr-api-key

# === Database ===
POSTGRES_DB=kixi
POSTGRES_USER=kixi
POSTGRES_PASSWORD=kixi_secret
POSTGRES_PORT=5433

# === Backend ===
BACKEND_PORT=8080
SPRING_PROFILE=docker
APP_JWT_EXPIRATION_MS=86400000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Simulation deadline grace period and expiry sweep interval.
APP_SIMULATIONS_TOLERANCE_SECONDS=10
APP_SIMULATIONS_EXPIRY_POLL_MS=60000
# API docs (springdoc). Set both to false in production to hide the API map.
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
# First ADMIN bootstrap (optional): with all three set, startup creates the
# first administrator if none exists. Without them nothing is created.
# Never commit real values here. After the first boot, remove the password
# from the environment and change it in the manager.
# APP_BOOTSTRAP_ADMIN_USERNAME=admin
# APP_BOOTSTRAP_ADMIN_EMAIL=admin@kixi.ao
# APP_BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-strong-password
# AI tutor (optional): without a key the /api/v1/chat endpoints answer 503.
# GROQ_API_KEY=

# === OCR service ===
ENVIRONMENT=docker
OCR_DEBUG=false
OCR_PORT=8000
OCR_WORKERS=1
OCR_LANG=pt
OCR_USE_GPU=false
OCR_LOG_LEVEL=INFO
